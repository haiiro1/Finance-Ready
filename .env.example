# Docker Compose environment variables

# PostgreSQL
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_ready
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000

# Backend JWT — cambiar SECRET_KEY antes de cualquier despliegue productivo
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
PASSWORD_RECOVERY_CODE_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=30

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@tu-dominio.cl
EMAIL_FROM_NAME=Finance Ready

# Google OAuth (mismo client ID para backend y frontend)
# Obtener en https://console.cloud.google.com — tipo "Web application"
# Agregar http://localhost:5173 como "Authorized JavaScript origin"
GOOGLE_CLIENT_ID=<web-client-id>.apps.googleusercontent.com

# Frontend
FRONTEND_PORT=5173
