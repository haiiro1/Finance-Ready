# This file serves as an example for the .env file.
# Copy this file to .env and fill in the values for your local environment.
# Docker Compose will automatically use the .env file in the project root.

# === PostgreSQL ===
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_ready
POSTGRES_PORT=5432

# === Backend & Frontend Ports ===
BACKEND_PORT=8000
FRONTEND_PORT=5173

# === Service URLs ===
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1