{
  "name": "finance-ready-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:shell": "pnpm --filter shell dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev:finanzas": "pnpm --filter finanzas dev",
    "dev:bancos-tarjetas": "pnpm --filter bancos-tarjetas dev",
    "dev:prestamos-deudas": "pnpm --filter prestamos-deudas dev",
    "dev:suscripciones": "pnpm --filter suscripciones dev",
    "dev:reportes": "pnpm --filter reportes dev",
    "dev:configuracion": "pnpm --filter configuracion dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "prettier": "^3.8.4"
  }
}
